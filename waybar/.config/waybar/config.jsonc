{
  "layer": "top",
  "position": "top",
  "height": 35,
  "modules-left": [
    "custom/os-icon",
    "hyprland/workspaces",
    "custom/quotes"
  ],
  "modules-center": ["custom/spotify"],
  "modules-right": ["custom/touchscreen", "bluetooth", "network", "custom/eject", "pulseaudio#microphone", "pulseaudio", "backlight", "battery", "clock", "custom/notification", "tray", "custom/power"],

  "custom/quotes": {
    "format": "{}",
    "tooltip": false,
    "exec": "~/.config/waybar/scripts/quotes.sh"
  },

  "custom/notification": {
    "format": "",
    "escape": true,
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "restart-interval": 2,
    "tooltip": true,
    "tooltip-format": "{} notification"
  },

  "custom/touchscreen": {
    "exec": "$HOME/.config/hypr/scripts/touch_screen.sh",
    "on-click": "$HOME/.config/hypr/scripts/touch_screen.sh toggle",
    "interval": 2,
    "return-type": "json",
    "tooltip": true
  },

  "custom/spotify": {
    "format": "󰝚 {}",
    "max-length": 40,
    "interval": 1,
    "exec": "playerctl --player=spotify,mpv metadata --format '{{ artist }} ~ {{ title }}' | sed 's/^ - //'",
    "exec-if": "playerctl --player=spotify,mpv status 2>/dev/null | grep -qE 'Playing|Paused'",
    "on-click": "playerctl --player=spotify,mpv play-pause",
    "on-scroll-up": "playerctl --player=spotify,mpv previous",
    "on-scroll-down": "playerctl --player=spotify,mpv next",
    "tooltip": false
  },

  "custom/eject": {
    "format": " ",
    "exec": "lsblk -no MOUNTPOINTS /dev/sda1 | grep -q / && echo '{\"text\": \"   Eject Ventoy\", \"tooltip\": \"Status: MOUNTED\\nclick to unmount\", \"class\": \"mounted\"}' || echo '{\"text\": \"\", \"tooltip\": \"Status: SAFE TO PULL\", \"class\": \"unmounted\"}'",
    "return-type": "json",
    "interval": 5,
    "on-click": "udiskie-umount /dev/sda1 && udisksctl power-off -b /dev/sda && notify-send Pendrive unmounted",
    "tooltip": true
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {"1": [], "2": [], "3": [], "4": [], "5": [],},
    "tooltip": false
  },

  "clock": {
    "format": "{:%d/%m ~ %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%d %B %Y  ~ %H:%M}",
    "on-click": "gsimplecal"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "network": {
    "interval": 2,
    "format-wifi": "󰖩 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ",
    "tooltip": true,
    "tooltip-format": "SSID: [ {essid} ]\n ST: [ {signalStrength}dBm ]\n IF: [ {ifname} ]",
    "on-click": "~/.config/waybar/scripts/nmtui.sh"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 ",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "tooltip": true,
    "tooltip-format": "Host Adapter: {controller_alias}\nStatus: {status}\nConn device: {device_enumerate}",
    "tooltip-format-connected": "Adapter: {controller_alias}\nConn to: {device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\nBattery: {device_battery_percentage}%",
    "on-click": "bluetoothctl show | grep -q 'Powered: yes' && (bluetoothctl power off && rfkill block bluetooth) || (rfkill unblock bluetooth && bluetoothctl power on)",
    "on-click-right": "bluetoothctl"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol"
  },

  "backlight": {
    "device": "amdgpu_b10",
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "on-click-right": "current=$(brightnessctl -d tpacpi::kbd_backlight g); if [ \"$current\" -eq 2 ]; then brightnessctl -d tpacpi::kbd_backlight s 0; else brightnessctl -d tpacpi::kbd_backlight s +1; fi",
    "scroll-step": 1,
    "interval": 2
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂋 {capacity}%",
    "format-plugged": "{icon} {capacity}%",
    "format-full": "󰂋 {capacity}%",
    "format-icons": ["󰁻", "󰁾", "󰂀", "󰂂"],
    "interval": 5
  }
}

