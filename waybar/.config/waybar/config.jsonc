{
  "layer": "top",
  "position": "top",
  "height": 35,
  "modules-left": [
    "custom/os-icon",
    "hyprland/workspaces", 
    "custom/quote"
  ],
  "modules-center": ["custom/spotify"],

  "modules-right": ["cpu", "memory", "network", "bluetooth", "pulseaudio", "backlight", "battery", "clock", "tray", "custom/power"],
  
  "custom/quote": {
    "format": "~ just get bangs hon ~",
    "tooltip": false
  },

  "custom/spotify": {
    "format": "󰝚 {}",
    "max-length": 40,
    "interval": 1,
    "exec": "echo \"$(playerctl --player=spotify metadata artist) - $(playerctl --player=spotify metadata title)\" 2>/dev/null",
    "exec-if": "pgrep spotify",
    "on-click": "playerctl --player=spotify play-pause",
    "on-scroll-up": "playerctl --player=spotify previous",
    "on-scroll-down": "playerctl --player=spotify next",
    "tooltip": false
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout -C ~/.config/wlogout/style.css -l ~/.config/wlogout/layout",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {"1": [], "2": [], "3": [], "4": [], "5": [],}
  },

  "clock": {
    "format": "{:%d/%m ~ %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%D [ %d %b %y ] ~ %H:%M}"
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%"
  },

  "memory": {
    "format": "  {used:0.1f}/{total:0.0f} GB"
  },

  "network": {
    "interval": 2,
    "format-wifi": "󰖩 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ",
    "tooltip": true,
    "tooltip-format": "SSID: [ {essid} ]\n ST: [ {signalStrength}dBm ]\n IF: [ {ifname} ]"
  },

"bluetooth": {
    "format": "",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {num_connections} ({device_battery_percentage}%)",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "tooltip": true,
    "tooltip-format": "Adapter: {controller_alias}\nStatus: {status}\nConn device: {device_enumerate}",
    "tooltip-format-connected": "Adapter: {controller_alias}\n\nConn to: {device_enumerate}",
    "tooltip-format-enumerate-connected": ">> {device_alias}\t(Battery: {device_battery_percentage}%)",
    "on-click": "bluetoothctl show | grep -q 'Powered: yes' && (bluetoothctl power off && rfkill block bluetooth) || (rfkill unblock bluetooth && bluetoothctl power on)"
},

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "backlight": {
    "device": "amdgpu_b10",
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "scroll-step": 1,
    "interval": 2
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂋 {capacity}%",
    "format-plugged": "{icon} {capacity}%",
    "format-full": "󰂋 {capacity}%",
    "format-icons": ["󰁻", "󰁾", "󰂀", "󰂂"],
    "interval": 5
  }
}
